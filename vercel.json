{
  "version": 2,
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/politica-de-privacidade",
      "destination": "/privacidade",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/automatizar",
      "destination": "/index.html"
    },
    {
      "source": "/solicitar-demonstracao",
      "destination": "/index.html"
    },
    {
      "source": "/servicos/nerva-rh",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
